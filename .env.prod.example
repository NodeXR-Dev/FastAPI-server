# 배포 서버용 .env 예시.
# 값을 채운 뒤 파일 이름을 .env 로 바꿔서 저장한다(.env 는 git 에 안 올라간다).
#
# <> 로 감싼 곳만 바꾸면 된다.

# ------------------------------------------------------------------
# 공개 주소
# ------------------------------------------------------------------
# VM 의 공인 IP 뒤에 .sslip.io 를 붙인다. 도메인을 안 사도 된다.
# 예) IP 가 152.67.10.20 이면  ->  152.67.10.20.sslip.io
SITE_ADDRESS=<VM공인IP>.sslip.io

# ------------------------------------------------------------------
# DB
# ------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nodexr
POSTGRES_USER=nodexr
# 개발용 nodexr123 을 그대로 쓰지 말 것. `openssl rand -hex 24` 결과를 넣는다.
POSTGRES_PASSWORD=<무작위값>
DATABASE_URL=postgresql+psycopg://nodexr:<위와같은값>@postgres:5432/nodexr
DB_ECHO=false

# ------------------------------------------------------------------
# MinIO (생성된 2D 이미지 저장소)
# ------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=<무작위값>
MINIO_SECRET_KEY=<무작위값>
MINIO_BUCKET_2D_ASSETS=nodexr-2d-assets
# 컨테이너끼리는 평문으로 통신한다. 바깥쪽 HTTPS 는 Caddy 담당이다.
MINIO_SECURE=false
# 클라이언트(Quest)가 이미지를 받아갈 주소. SITE_ADDRESS 와 같아야 한다.
MINIO_PUBLIC_BASE_URL=https://<VM공인IP>.sslip.io

# ------------------------------------------------------------------
# 외부 API 키
# ------------------------------------------------------------------
OPENAI_API_KEY=<키>
OPENAI_PROMPT_MODEL=gpt-4.1-mini
OPENAI_MODEL_NAME=gpt-4o-mini
# 아래 둘이 비어 있으면 2D/3D 생성 단계에서 막힌다.
GEMINI_API_KEY=<키>
GEMINI_MODEL_NAME=gemini-3.1-flash-image
MESHY_API_KEY=<키>

# ------------------------------------------------------------------
# 임베딩 / 판정 기준값
# ------------------------------------------------------------------
EMBEDDING_DIM=768
TOPIC_DRIFT_THRESHOLD=0.55
DISCUSSION_SIMILARITY_THRESHOLD=0.78
